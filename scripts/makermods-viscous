#!/usr/bin/env python3
"""Open the commissioned Viscous Lab from its Linux desktop or the MacBook."""

import json
import os
import platform
import subprocess
import sys
import time
import urllib.request

URL = "http://100.64.91.4:8000"
SERVICE = "makermodslab-viscous.service"


def main():
    system = platform.system()
    if system not in {"Darwin", "Linux"}:
        print("This launcher supports the MacBook and Linux desktop.", file=sys.stderr)
        return 1

    command = ["systemctl", "--user", "start", SERVICE]
    if system == "Darwin":
        command = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "gavin-linux", *command]
    print("Starting MakerMods Lab on gavin-linux…", flush=True)
    result = subprocess.run(command)
    if result.returncode:
        print("Check that the Linux desktop and Tailscale are online.", file=sys.stderr)
        return result.returncode

    for _ in range(30):
        try:
            with urllib.request.urlopen(URL + "/api/v1/arms", timeout=2) as response:
                arms = json.load(response)["arms"]
            if any(arm["id"] == "viscous" for arm in arms):
                break
        except (OSError, ValueError, KeyError):
            pass
        time.sleep(1)
    else:
        print("Lab did not become ready. On Linux, inspect:", file=sys.stderr)
        print("journalctl --user -u makermodslab-viscous -n 30", file=sys.stderr)
        return 1

    print("MakerMods Lab is ready: " + URL)
    if system == "Darwin":
        return subprocess.run(["open", URL]).returncode
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        subprocess.Popen(
            ["xdg-open", URL],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
