#!/usr/bin/env python3
"""Open the commissioned Viscous Lab from its Linux desktop or the MacBook."""

import argparse
import json
import os
import platform
import plistlib
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

LINUX_URL = "http://100.64.91.4:8000"
MAC_URL = "http://127.0.0.1:8000"
SERVICE = "makermodslab-viscous.service"


def start_mac():
    root = Path(__file__).resolve().parent.parent
    python = root / ".venv/bin/python"
    if not python.exists() or not (root / "frontend/dist/index.html").exists():
        print(
            "Install the dependencies and build the frontend first; see docs/viscous-arm.md.", file=sys.stderr
        )
        return 1
    label = "com.gavin.makermods-viscous"
    domain = f"gui/{os.getuid()}"
    service = f"{domain}/{label}"
    loaded = subprocess.run(["launchctl", "print", service], capture_output=True).returncode == 0
    if not loaded:
        state = Path.home() / ".makermods/makermodslab-viscous"
        state.mkdir(parents=True, exist_ok=True)
        plist = Path.home() / "Library/LaunchAgents" / f"{label}.plist"
        plist.parent.mkdir(parents=True, exist_ok=True)
        if not plist.exists():
            plist.write_bytes(
                plistlib.dumps(
                    {
                        "Label": label,
                        "ProgramArguments": [
                            str(python),
                            "-m",
                            "uvicorn",
                            "makermodslab.server:app",
                            "--host",
                            "127.0.0.1",
                            "--port",
                            "8000",
                        ],
                        "WorkingDirectory": str(root),
                        "EnvironmentVariables": {
                            "MAKERMODSLAB_HOME": str(state),
                            "PATH": f"{python.parent}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
                        },
                        "StandardOutPath": str(state / "server.log"),
                        "StandardErrorPath": str(state / "server.log"),
                        "RunAtLoad": False,
                        "KeepAlive": False,
                    }
                )
            )
        result = subprocess.run(["launchctl", "bootstrap", domain, str(plist)])
        if result.returncode:
            return result.returncode
    # Without -k, kickstart leaves an already running server/session alone.
    return subprocess.run(["launchctl", "kickstart", service]).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--remote", action="store_true", help="open the Linux desktop over Tailscale")
    parser.add_argument("--no-browser", action="store_true", help="start Lab and print its address")
    args = parser.parse_args()
    system = platform.system()
    if system not in {"Darwin", "Linux"}:
        print("This launcher supports the MacBook and Linux desktop.", file=sys.stderr)
        return 1

    local_mac = system == "Darwin" and not args.remote
    url = MAC_URL if local_mac else LINUX_URL
    print(f"Starting MakerMods Lab on {'this Mac' if local_mac else 'gavin-linux'}…", flush=True)
    if local_mac:
        returncode = start_mac()
    else:
        command = ["systemctl", "--user", "start", SERVICE]
        if system == "Darwin":
            command = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "gavin-linux", *command]
        returncode = subprocess.run(command).returncode
    if returncode:
        return returncode

    for _ in range(30):
        try:
            with urllib.request.urlopen(url + "/api/v1/arms", timeout=2) as response:
                arms = json.load(response)["arms"]
            if any(arm["id"] == "viscous" for arm in arms):
                break
        except (OSError, ValueError, KeyError):
            pass
        time.sleep(1)
    else:
        print("Lab did not become ready. Inspect:", file=sys.stderr)
        print(
            "~/.makermods/makermodslab-viscous/server.log"
            if local_mac
            else "journalctl --user -u makermodslab-viscous -n 30",
            file=sys.stderr,
        )
        return 1

    print("MakerMods Lab is ready: " + url)
    if args.no_browser:
        return 0
    if system == "Darwin":
        return subprocess.run(["open", url]).returncode
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        subprocess.Popen(
            ["xdg-open", url],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
